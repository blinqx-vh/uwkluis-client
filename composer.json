{
  "name": "uwkluis/client",
  "description": "Client package for the UwKluis APIs",
  "license": "MIT",
  "type": "library",
  "archive": {
    "exclude": [
      "tests/",
      "phpunit.xml",
      ".scrutinizer.yml",
      "bitbucket-pipelines.yml"
    ]
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "beberlei/assert": "^3.2",
    "caseyamcl/guzzle_retry_middleware": "^2.9",
    "fig/http-message-util": "^1.1",
    "guzzlehttp/guzzle": "^6.3|^7.0",
    "lcobucci/jwt": "^4.1",
    "psr/http-message": "^1.0",
    "ramsey/uuid": "^3.7|^4.0",
    "uwkluis/enums": "^0.1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0",
    "roave/backward-compatibility-check": "~8.0",
    "squizlabs/php_codesniffer": "^3.3"
  },
  "suggest": {
    "illuminate/support": "Needed to use the Laravel service provider"
  },
  "autoload": {
    "psr-4": {
      "UwKluis\\Client\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UwKluis\\Client\\": "tests/"
    }
  },
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "check-style": "./vendor/bin/phpcs -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src tests",
    "fix-style": "./vendor/bin/phpcbf -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src tests"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "config": {
    "sort-packages": true
  }
}
